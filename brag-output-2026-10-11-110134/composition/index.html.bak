    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });

      /* ═════ Scene 1 · 0.00 → 5.80 ═════ */
      tl.fromTo("#s1-eyebrow",
        { opacity: 0, y: 22 },
        { opacity: 1, y: 0, duration: 0.55, ease: "power3.out" }, 0.20);
      tl.fromTo("#s1-title",
        { opacity: 0, scale: 0.93 },
        { opacity: 1, scale: 1, duration: 0.85, ease: "power3.out" }, 0.85);
      tl.fromTo("#s1-byline",
        { opacity: 0, y: 18 },
        { opacity: 1, y: 0, duration: 0.55, ease: "power3.out" }, 2.10);

      // problem reveal on strong beat 3.70
      tl.to("#s1-eyebrow", { opacity: 0, y: -18, duration: 0.35 }, 3.70);
      tl.to("#s1-title",   { opacity: 0, y: -24, duration: 0.35 }, 3.74);
      tl.to("#s1-byline",  { opacity: 0, y: -18, duration: 0.35 }, 3.74);
      tl.fromTo("#s1-problem-num",
        { opacity: 0, y: 32, scale: 0.96 },
        { opacity: 1, y: 0, scale: 1, duration: 0.55, ease: "power3.out" }, 3.92);
      tl.fromTo("#s1-problem-sub",
        { opacity: 0, y: 20 },
        { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, 4.20);

      /* ═════ Scene 2 · 5.80 → 12.65 ═════ */
      tl.fromTo("#s2-toolbar",
        { opacity: 0, y: -16 },
        { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, 5.95);
      tl.fromTo("#s2-left",
        { opacity: 0, x: -36 },
        { opacity: 1, x: 0, duration: 0.65, ease: "power3.out" }, 6.05);
      tl.fromTo("#s2-right",
        { opacity: 0, x: 36 },
        { opacity: 1, x: 0, duration: 0.65, ease: "power3.out" }, 6.12);
      tl.fromTo("#s2-gauge",
        { opacity: 0, y: 24 },
        { opacity: 1, y: 0, duration: 0.55, ease: "power3.out" }, 6.34);

      // retention chips on sequential beats
      tl.fromTo("#chip1",
        { opacity: 0, y: 18, scale: 0.9 },
        { opacity: 1, y: 0, scale: 1, duration: 0.4, ease: "back.out(1.6)" }, 9.50);
      tl.fromTo("#chip2",
        { opacity: 0, y: 18, scale: 0.9 },
        { opacity: 1, y: 0, scale: 1, duration: 0.4, ease: "back.out(1.6)" }, 10.54);
      tl.fromTo("#chip3",
        { opacity: 0, y: 18, scale: 0.9 },
        { opacity: 1, y: 0, scale: 1, duration: 0.4, ease: "back.out(1.6)" }, 11.60);
      tl.fromTo("#s2-retention",
        { opacity: 0, scale: 0.82 },
        { opacity: 1, scale: 1, duration: 0.5, ease: "back.out(1.8)" }, 12.12);

      /* ═════ Scene 3 · 12.65 → 18.44 ═════ */
      tl.fromTo("#s3-eyebrow",
        { opacity: 0, y: 16 },
        { opacity: 1, y: 0, duration: 0.45, ease: "power3.out" }, 12.80);
      tl.fromTo("#s3-title",
        { opacity: 0, y: 22 },
        { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, 12.92);
      tl.fromTo("#fmt1",
        { opacity: 0, y: 36 },
        { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, 13.18);
      tl.fromTo("#fmt2",
        { opacity: 0, y: 36 },
        { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, 14.22);
      tl.fromTo("#fmt3",
        { opacity: 0, y: 36 },
        { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, 15.28);
      tl.fromTo("#s3-footer",
        { opacity: 0, y: 14 },
        { opacity: 1, y: 0, duration: 0.45, ease: "power3.out" }, 16.34);

      /* ═════ Scene 4 · 18.44 → 24.23 ═════ */
      tl.fromTo("#s4-eyebrow",
        { opacity: 0, y: 14 },
        { opacity: 1, y: 0, duration: 0.4, ease: "power3.out" }, 18.60);

      // four format chips expand 18.96 → 19.9
      tl.fromTo("#fchip1",
        { opacity: 0, y: 14, scale: 0.93 },
        { opacity: 1, y: 0, scale: 1, duration: 0.32, ease: "power2.out" }, 18.96);
      tl.fromTo("#fchip2",
        { opacity: 0, y: 14, scale: 0.93 },
        { opacity: 1, y: 0, scale: 1, duration: 0.32, ease: "power2.out" }, 19.18);
      tl.fromTo("#fchip3",
        { opacity: 0, y: 14, scale: 0.93 },
        { opacity: 1, y: 0, scale: 1, duration: 0.32, ease: "power2.out" }, 19.40);
      tl.fromTo("#fchip4",
        { opacity: 0, y: 14, scale: 0.93 },
        { opacity: 1, y: 0, scale: 1, duration: 0.32, ease: "power2.out" }, 19.62);

      // chips clear for the tagline
      tl.to("#s4-formats", { opacity: 0, y: -14, duration: 0.4, ease: "power2.in" }, 20.14);

      // tagline halves on beats
      tl.fromTo("#tag1",
        { opacity: 0, y: 26 },
        { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, 20.54);
      tl.fromTo("#tag2",
        { opacity: 0, y: 26 },
        { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, 21.59);

      // final lockup on strong beat 22.65
      tl.to("#s4-tag", { opacity: 0, y: -18, duration: 0.4, ease: "power2.in" }, 22.65);
      tl.fromTo("#lockup-mark",
        { opacity: 0, scale: 0.94 },
        { opacity: 1, scale: 1, duration: 0.6, ease: "power3.out" }, 22.72);
      tl.fromTo("#lockup-tag",
        { opacity: 0, y: 14 },
        { opacity: 1, y: 0, duration: 0.45, ease: "power3.out" }, 23.05);
      tl.fromTo("#lockup-url",
        { opacity: 0, y: 12 },
        { opacity: 1, y: 0, duration: 0.45, ease: "power3.out" }, 23.30);

      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
