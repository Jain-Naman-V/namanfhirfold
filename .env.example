# OPENAI_API_KEY: Required for live LLM inference (CDS Q&A endpoint).
# Point at OpenAI, or any OpenAI-compatible provider (Ollama, vLLM, LM Studio, proxies).
# Configure via the Secrets panel in the AI Studio UI (injected at runtime).
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# OPENAI_BASE_URL: OpenAI-compatible API base URL.
# Defaults to https://api.openai.com/v1 when unset.
OPENAI_BASE_URL="https://api.openai.com/v1"

# OPENAI_MODEL: Model id used for inference.
# Defaults to gpt-4o-mini when unset.
OPENAI_MODEL="gpt-4o-mini"
